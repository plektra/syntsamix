(footprint "Kycon_KPJX-4S_Horizontal"
	(version 20241229)
	(generator "pcbnew")
	(generator_version "9.0")
	(layer "F.Cu")
	(descr "Kycon KPJX-4S locking 4-pin power DIN jack, right angle, mates Kycon KPPX-4P and Mean Well R7B. Pads from Kycon drawing KPJX-4S rev A13 (2022-08-15), recommended PCB layout (bottom view, mirrored here to the top view). Origin at the front face of the barrel on the jack axis, body toward +Y: barrel Ø12.9 x 4.0, body 15 x 17.0 deep, axis about 7.5 mm above the board. Contacts in 0.6 x 2.7 plated slots (pins 3, 4 at 11.0 mm, 5.0 apart; pins 1, 2 at 14.65 mm, 5.8 apart), two Ø1.5 plastic pegs in Ø1.7 holes, shield tab in a 2.2 x 1.0 plated slot (no number). No panel thread or nut: the barrel passes a panel hole, the board carries the jack. https://www.kycon.com/Pub_Eng_Draw/KPJX-4S.pdf")
	(tags "power DIN jack 4-pin locking Kycon KPJX-4S R7B")
	(property "Reference" "REF**"
		(at 0 -2 0)
		(layer "F.SilkS")
		(effects

		(rev "0.1")
		(company "Syntsamix")
		(comment 1 "Pre-fader buffers U301 feed PFL, SC send, meter and AUX pre option")
		(comment 2 "Bus resistors 22k into 22k virtual-earth amps on the master card (unity); SC = (L+R)/2")
		(comment 3 "AUX pre/post: J301/J302, default POST; COMP BUS pressed = compressor bus; JP301 2-3: FLT1/FLT2 instead (reserved)")
		(comment 4 "PFL_ACT: open collector to PGND, pulled up on the master card; U304: SC send off while SW302 pin 1 is high")
	)

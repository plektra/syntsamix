		(rev "0.1")
		(company "Syntsamix")
		(comment 1 "Power ribbons (docs/CHAIN.md): J401 master card, J402 chain 1 (cards 1-8), J403 chain 2 (cards 9-16)")
		(comment 2 "One 2 A PTC per rail per header: a shorted card or ribbon trips its own fuse (decision 100)")
		(comment 3 "Würth 61200821621 headers, 3 A per contact; IDC sockets 61200823021 are 1 A per contact (two per rail)")
		(comment 4 "PGND reaches AGND only at the master card's star point (decision 42, invariant 2)")
	)

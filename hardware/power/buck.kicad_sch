	(title_block
		(title "Power board: +20 V buck")
		(date "2026-10-07")
		(rev "0.1")
		(company "Syntsamix")
		(comment 1 "TPS54560 buck, 24 V to +20 V at 2 A, synced to CLK_A (about 400 kHz; RT alone gives 400 kHz)")
		(comment 2 "UVLO start 21.1 V, stop 18.7 V: waits for the input soft start (design.py)")
		(comment 3 "Feedback before the LC filter; 2.2 uH + 330 uF polymer + 100 uF damping, about 47 dB at 400 kHz")
		(comment 4 "Values from TI SLVSBN0C section 8.2.2 (design.py)")
	)

	(uuid "7933f77f-ae90-471f-a038-bf6287f432a9")
	(paper "A2")
	(title_block
		(title "Power board: input and clock")
		(date "2026-10-07")
		(rev "0.1")
		(company "Syntsamix")
		(comment 1 "24 V brick (Mean Well GSM120B24-R7B) on a locking 4-pin DIN jack; check polarity on the first brick")
		(comment 2 "Q101 blocks a reversed brick, Q102 ramps the input in about 7 ms; the rocker on J102 carries gate current only")
		(comment 3 "SMBJ24A clamps at 38.9 V so the inverter IC (VIN + 20 V) stays under 60 V (decision 100)")
		(comment 4 "74HC14 RC oscillator about 400 kHz; CLK_A and CLK_B in opposite phase sync the two TPS54560")
	)

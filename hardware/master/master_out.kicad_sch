		(rev "0.1")
		(company "Syntsamix")
		(comment 1 "SSI2162 master VCA, fader law on RV701 (+10 dB full, 0 dB at 75 %); soft clip about +14 dBu")
		(comment 2 "THAT1646 drivers (+6 dB), CM offset caps and rail clamps (THAT doc 600078 Fig. 5, 8)")
		(comment 3 "G6K relays: released = output to AGND via 1k; on 2 s after power-up, off below raw 17.9 V")
		(comment 4 "Decisions 83, 85, 92; RLY_N also drives the headphone relay")
	)

		(company "Syntsamix")
		(comment 1 "Stereo-linked SSI2162 on the COMP bus; MIX crossfades dry/wet (RV401), output sums into MAIN through 22k")
		(comment 2 "Detector: full-wave rectifier, log converter on the AS3046D pair (ERA-V33 tempco), peak hold 1 ms attack, RELEASE 44 ms-1.4 s per 10 dB")
		(comment 3 "4:1 above threshold; AMOUNT lowers the threshold 0-30 dB with makeup 0.735 x (fit R439 for half); ON ramps Amount in about 20 ms")
		(comment 4 "Decisions 57, 82 and 89; values simulated in simulation/compressor/run.py")
	)
